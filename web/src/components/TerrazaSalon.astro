---

---
<section class="py-20 md:py-32 bg-cream-100">
  <div class="max-w-7xl mx-auto px-5 md:px-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 min-h-[500px]">
      <!-- Terraza -->
      <div class="group relative rounded-lg overflow-hidden cursor-pointer min-h-[300px] md:min-h-[500px] md:transition-all md:duration-700 md:hover:col-span-1 reveal-left">
        <img src="/images/local-lleno.jpg" alt="Terraza exterior del restaurante La Flecha de Pedro en Móstoles" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal-900/80 via-charcoal-900/30 to-transparent"></div>
        <div class="relative z-10 flex flex-col justify-end h-full p-8 md:p-12">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <span class="font-sans font-semibold text-xs tracking-[0.2em] uppercase text-amber">Al aire libre</span>
          </div>
          <h3 class="font-display text-3xl md:text-4xl text-white mb-3">La Terraza</h3>
          <p class="text-white/70 text-sm md:text-base max-w-sm">
            Amplia terraza exterior para disfrutar del sol de Madrid. El lugar perfecto
            para un vermú con calma o una cena de verano.
          </p>
          <!-- Hover reveal -->
          <div class="mt-4 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-400">
            <span class="font-sans text-xs tracking-widest uppercase text-amber/80">Menú terraza: 26,50&euro;</span>
          </div>
        </div>
      </div>

      <!-- Salón -->
      <div class="group relative rounded-lg overflow-hidden cursor-pointer min-h-[300px] md:min-h-[500px] md:transition-all md:duration-700 reveal-right reveal-delay-1">
        <img src="/images/pedro-sala.jpg" alt="Salón interior climatizado del restaurante La Flecha de Pedro en Móstoles para celebraciones y grupos" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal-900/80 via-charcoal-900/30 to-transparent"></div>
        <div class="relative z-10 flex flex-col justify-end h-full p-8 md:p-12">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.99 11.256A5.256 5.256 0 0 0 6.75 16.5c0 2.004 1.125 3.75 2.774 4.632A5.25 5.25 0 0 0 12 21a5.25 5.25 0 0 0 2.476-.868A5.25 5.25 0 0 0 17.25 16.5a5.256 5.256 0 0 0-5.26-5.244Z" />
            </svg>
            <span class="font-sans font-semibold text-xs tracking-[0.2em] uppercase text-amber">Climatizado</span>
          </div>
          <h3 class="font-display text-3xl md:text-4xl text-white mb-3">El Salón</h3>
          <p class="text-white/70 text-sm md:text-base max-w-sm">
            Salón interior climatizado con ambiente íntimo y acogedor.
            Ideal para comidas familiares, celebraciones y reuniones de empresa.
          </p>
          <!-- Hover reveal -->
          <div class="mt-4 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-400">
            <span class="font-sans text-xs tracking-widest uppercase text-amber/80">Grupos y eventos disponibles</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
