---
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'Carta', href: '/carta' },
  { label: 'Ubicaciones', href: '#ubicaciones' },
  { label: 'Nosotros', href: '#tradicion' },
];

const legalLinks = [
  { label: 'Aviso legal', href: '#' },
  { label: 'Privacidad', href: '#' },
  { label: 'Cookies', href: '#' },
];
---
<footer id="contacto" class="relative bg-texture-dark pt-20 pb-10">
  <!-- Top decorative line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-5 md:px-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-16">
      <!-- Brand -->
      <div class="md:col-span-3">
        <div class="mb-4 relative inline-block">
          <img src="/images/logo.png" alt="La Flecha de Pedro" class="h-10 brightness-0 invert" />
          <span class="absolute -bottom-2.5 right-0 font-sans text-[10px] tracking-[0.15em] text-amber italic">de Pedro</span>
        </div>
        <p class="text-white/50 text-sm leading-relaxed max-w-xs mb-6">
          Cocina tradicional mediterránea. Hecha a fuego lento desde 1994.
        </p>
        <!-- Social -->
        <div class="flex items-center gap-4">
          <a href="https://www.instagram.com/laflechadepedro/" target="_blank" rel="noopener" class="text-white/40 hover:text-amber transition-colors duration-300" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
          </a>
          <a href="#" target="_blank" rel="noopener" class="text-white/40 hover:text-amber transition-colors duration-300" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="md:col-span-2 md:col-start-5">
        <h4 class="font-sans font-semibold text-xs tracking-[0.15em] uppercase text-amber mb-5">Navegar</h4>
        <ul class="flex flex-col gap-3">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="text-white/60 text-sm hover:text-white transition-colors duration-300">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact - Local 1 -->
      <div class="md:col-span-3">
        <h4 class="font-sans font-semibold text-xs tracking-[0.15em] uppercase text-amber mb-5">P.º de Goya</h4>
        <ul class="flex flex-col gap-3 text-white/60 text-sm">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold/60 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <a href="tel:916147890" class="hover:text-white transition-colors">91 614 78 90</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-gold/60 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" />
            </svg>
            <span>P.º de Goya, 2, Local<br />28931 Móstoles, Madrid</span>
          </li>
        </ul>
      </div>

      <!-- Contact - Local 2 -->
      <div class="md:col-span-3">
        <h4 class="font-sans font-semibold text-xs tracking-[0.15em] uppercase text-amber mb-5">Juan XXIII</h4>
        <ul class="flex flex-col gap-3 text-white/60 text-sm">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold/60 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <a href="tel:915744034" class="hover:text-white transition-colors">91 574 40 34</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-gold/60 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" />
            </svg>
            <span>C. de Juan XXIII, 9<br />28931 Móstoles, Madrid</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-white/30 text-xs">
        &copy; {currentYear} La Flecha de Pedro. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6">
        {legalLinks.map(link => (
          <a href={link.href} class="text-white/30 text-xs hover:text-white/60 transition-colors duration-300">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
