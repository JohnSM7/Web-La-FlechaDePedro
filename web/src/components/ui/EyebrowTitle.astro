---
interface Props {
  eyebrow: string;
  dark?: boolean;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, dark = false, align = 'center', class: className } = Astro.props;
const textColor = dark ? 'text-amber' : 'text-amber-dark';
const lineColor = dark ? 'bg-gold' : 'bg-gold';
const alignment = align === 'center' ? 'justify-center' : 'justify-start';
---
<div class:list={['flex items-center gap-4 mb-4', alignment, className]}>
  <span class:list={['h-px w-8', lineColor]} aria-hidden="true"></span>
  <span class:list={[
    'font-sans font-semibold text-xs tracking-[0.2em] uppercase',
    textColor
  ]}>
    {eyebrow}
  </span>
  <span class:list={['h-px w-8', lineColor]} aria-hidden="true"></span>
</div>
