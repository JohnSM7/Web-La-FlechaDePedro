---
import EyebrowTitle from './ui/EyebrowTitle.astro';
import LocationCard from './ui/LocationCard.astro';
---
<section id="ubicaciones" class="py-20 md:py-32 bg-cream-50">
  <div class="max-w-7xl mx-auto px-5 md:px-10">
    <!-- Header -->
    <div class="text-center mb-14 reveal">
      <EyebrowTitle eyebrow="Dónde encontrarnos" />
      <h2 class="font-display text-3xl md:text-5xl text-charcoal-900">
        Dos casas, la misma <span class="text-terracotta italic">cocina</span>
      </h2>
    </div>

    <!-- Location cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 reveal reveal-delay-1">
      <LocationCard
        name="Paseo de Goya"
        address="P.º de Goya, 2, Local, 28931 Móstoles, Madrid"
        phone="91 614 78 90"
        hours={"Lunes a Sábado: 12:00 – 16:30 / 20:00 – 23:30\nDomingo: 12:00 – 17:00"}
        mapEmbed="https://www.openstreetmap.org/export/embed.html?bbox=-3.8662%2C40.3240%2C-3.8582%2C40.3280&layer=mapnik&marker=40.3260%2C-3.8622"
        reserveHref="tel:916147890"
      />
      <LocationCard
        name="Juan XXIII"
        badge="Nuevo"
        address="C. de Juan XXIII, 9, 28931 Móstoles, Madrid"
        phone="91 574 40 34"
        hours={"Lunes a Jueves: 7:00 – 00:00\nViernes y Sábado: 7:00 – 01:00\nDomingo: 7:00 – 00:00"}
        mapEmbed="https://www.openstreetmap.org/export/embed.html?bbox=-3.8682%2C40.3180%2C-3.8602%2C40.3220&layer=mapnik&marker=40.3200%2C-3.8642"
        reserveHref="tel:915744034"
      />
    </div>

    <!-- Tip -->
    <p class="text-center text-charcoal-500 text-sm mt-10">
      <svg class="w-4 h-4 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
      </svg>
      Llámanos antes de las 13:00 para asegurar mesa en la comida.
    </p>
  </div>
</section>
