---
import Button from './ui/Button.astro';
---
<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background image with Ken Burns -->
  <div class="absolute inset-0 animate-kenburns">
    <img src="/images/pedro-sala.jpg" alt="Restaurante La Flecha de Pedro en Móstoles — salón interior" class="w-full h-full object-cover object-center" loading="eager" />
  </div>

  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-charcoal-900/55"></div>

  <!-- Decorative top line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-5 max-w-3xl mx-auto">
    <!-- Eyebrow -->
    <div class="flex items-center justify-center gap-4 mb-6">
      <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
      <span class="font-sans font-semibold text-[11px] md:text-xs tracking-[0.25em] uppercase text-amber">
        Cocina tradicional desde 1994
      </span>
      <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
    </div>

    <!-- Title -->
    <h1 class="font-display text-5xl md:text-7xl lg:text-8xl text-white mb-2 tracking-tight">
      La Flecha
    </h1>
    <p class="font-display text-2xl md:text-3xl lg:text-4xl text-amber italic mb-6">
      de Pedro
    </p>

    <!-- Subtitle -->
    <p class="font-sans text-white/70 text-base md:text-lg mb-10 tracking-wide">
      Tu restaurante en Móstoles desde hace 30 años. Ven a comprobarlo.
    </p>

    <!-- Ubicaciones CTA -->
    <p class="font-sans text-xs tracking-[0.2em] uppercase text-white/50 mb-4">Nuestras ubicaciones</p>
    <div class="flex flex-row items-center justify-center gap-4">
      <a
        href="#ubicaciones"
        class="inline-flex items-center gap-2 px-6 py-3 bg-amber text-charcoal-900 font-sans font-semibold text-xs tracking-widest uppercase rounded transition-all duration-300 hover:bg-amber-dark hover:-translate-y-0.5 hover:shadow-lg"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" />
        </svg>
        P.º de Goya, 2
      </a>
      <a
        href="#ubicaciones"
        class="inline-flex items-center gap-2 px-6 py-3 bg-amber text-charcoal-900 font-sans font-semibold text-xs tracking-widest uppercase rounded transition-all duration-300 hover:bg-amber-dark hover:-translate-y-0.5 hover:shadow-lg"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" />
        </svg>
        C. Juan XXIII, 9
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce-gentle">
    <span class="font-sans text-[10px] tracking-[0.2em] uppercase text-white/40">Descubre</span>
    <svg class="w-5 h-5 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </div>

  <!-- Bottom gradient fade into cream -->
  <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-cream-50 to-transparent"></div>
</section>
