---
---
<!-- Botón flotante de teléfono -->
<button
  id="phone-btn"
  class="fixed bottom-6 right-4 z-40 w-12 h-12 sm:w-14 sm:h-14 bg-amber rounded-full flex items-center justify-center shadow-lg hover:shadow-xl hover:scale-110 transition-all duration-300 opacity-0 translate-y-4 cursor-pointer"
  aria-label="Llamar para reservar"
>
  <svg class="w-6 h-6 sm:w-7 sm:h-7 text-charcoal-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
  </svg>
</button>

<!-- Modal elegir sede -->
<div id="phone-modal" class="fixed inset-0 z-50 hidden">
  <div id="phone-overlay" class="absolute inset-0 bg-charcoal-900/60 backdrop-blur-sm"></div>
  <div class="absolute inset-0 flex items-center justify-center p-5">
    <div class="relative bg-cream-50 rounded-xl shadow-2xl max-w-sm w-full p-8 transform scale-95 opacity-0 transition-all duration-300" id="phone-panel">
      <!-- Cerrar -->
      <button id="phone-close" class="absolute top-4 right-4 text-charcoal-400 hover:text-charcoal-900 transition-colors cursor-pointer" aria-label="Cerrar">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>

      <h3 class="font-display text-2xl text-charcoal-900 mb-2 text-center">¿A qué sede llamas?</h3>
      <p class="font-sans text-sm text-charcoal-500 mb-6 text-center">Elige una ubicación para llamar directamente</p>

      <div class="flex flex-col gap-3">
        <a
          href="tel:916147890"
          class="flex items-center gap-4 p-4 bg-white border border-cream-200 rounded-lg hover:border-amber hover:shadow-md transition-all duration-200 group"
        >
          <div class="w-10 h-10 bg-amber/10 rounded-full flex items-center justify-center flex-shrink-0 group-hover:bg-amber/20 transition-colors">
            <svg class="w-5 h-5 text-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" />
            </svg>
          </div>
          <div class="flex-1">
            <span class="font-sans font-semibold text-sm text-charcoal-900 block">P.º de Goya, 2</span>
            <span class="font-sans text-xs text-charcoal-500">91 614 78 90</span>
          </div>
          <svg class="w-5 h-5 text-charcoal-400 group-hover:text-amber transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
        </a>

        <a
          href="tel:915744034"
          class="flex items-center gap-4 p-4 bg-white border border-cream-200 rounded-lg hover:border-amber hover:shadow-md transition-all duration-200 group relative"
        >
          <span class="absolute -top-2 -right-2 bg-amber text-charcoal-900 font-sans font-bold text-[8px] tracking-wider uppercase px-1.5 py-0.5 rounded-full leading-none">Nuevo</span>
          <div class="w-10 h-10 bg-amber/10 rounded-full flex items-center justify-center flex-shrink-0 group-hover:bg-amber/20 transition-colors">
            <svg class="w-5 h-5 text-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" />
            </svg>
          </div>
          <div class="flex-1">
            <span class="font-sans font-semibold text-sm text-charcoal-900 block">C. Juan XXIII, 9</span>
            <span class="font-sans text-xs text-charcoal-500">91 574 40 34</span>
          </div>
          <svg class="w-5 h-5 text-charcoal-400 group-hover:text-amber transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const phoneBtn = document.getElementById('phone-btn');
  const phoneModal = document.getElementById('phone-modal');
  const phonePanel = document.getElementById('phone-panel');
  const phoneOverlay = document.getElementById('phone-overlay');
  const phoneClose = document.getElementById('phone-close');

  setTimeout(() => {
    phoneBtn?.classList.remove('opacity-0', 'translate-y-4');
    phoneBtn?.classList.add('opacity-100', 'translate-y-0');
  }, 2000);

  function openModal() {
    phoneModal?.classList.remove('hidden');
    requestAnimationFrame(() => {
      phonePanel?.classList.remove('scale-95', 'opacity-0');
      phonePanel?.classList.add('scale-100', 'opacity-100');
    });
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    phonePanel?.classList.add('scale-95', 'opacity-0');
    phonePanel?.classList.remove('scale-100', 'opacity-100');
    setTimeout(() => {
      phoneModal?.classList.add('hidden');
      document.body.style.overflow = '';
    }, 200);
  }

  phoneBtn?.addEventListener('click', openModal);
  phoneClose?.addEventListener('click', closeModal);
  phoneOverlay?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !phoneModal?.classList.contains('hidden')) closeModal();
  });

  const cookieBanner = document.getElementById('cookie-banner');
  if (cookieBanner) {
    const observer = new MutationObserver(() => {
      const visible = cookieBanner.classList.contains('translate-y-0');
      if (visible) {
        phoneBtn?.classList.add('!bottom-28');
      } else {
        phoneBtn?.classList.remove('!bottom-28');
      }
    });
    observer.observe(cookieBanner, { attributes: true, attributeFilter: ['class'] });
  }
</script>
