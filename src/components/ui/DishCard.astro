---
interface Props {
  name: string;
  price: string;
  image: string;
  badge?: string;
}

const { name, price, image, badge } = Astro.props;
---
<div class="group flex-shrink-0 w-72 bg-white border border-cream-200 rounded-lg overflow-hidden transition-all duration-400 hover:shadow-[0_8px_32px_rgba(28,24,20,0.08)] cursor-pointer snap-start">
  <div class="relative overflow-hidden aspect-[4/3]">
    {image
      ? <img src={image} alt={name} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
      : <div class="w-full h-full bg-cream-200 flex items-center justify-center text-charcoal-400 text-sm">Foto del plato</div>
    }
    {badge && (
      <span class="absolute top-3 right-3 bg-amber text-charcoal-900 font-sans font-semibold text-[10px] tracking-widest uppercase px-3 py-1 rounded-full">
        {badge}
      </span>
    )}
  </div>
  <div class="p-5">
    <h4 class="font-sans font-semibold text-charcoal-900 text-base mb-1">{name}</h4>
    <span class="font-display text-terracotta text-xl">{price}</span>
  </div>
</div>
