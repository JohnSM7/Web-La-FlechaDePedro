---
interface Props {
  name: string;
  address: string;
  phone: string;
  hours: string;
  mapEmbed?: string;
  reserveHref?: string;
  badge?: string;
}

const { name, address, phone, hours, mapEmbed, reserveHref = '#', badge } = Astro.props;
---
<div class="relative bg-white border border-cream-200 rounded-lg overflow-hidden p-8 flex flex-col gap-6">
  {badge && <span class="absolute top-4 right-4 bg-amber text-charcoal-900 font-sans font-bold text-[10px] tracking-wider uppercase px-3 py-1.5 rounded-full leading-none z-10 shadow-md">{badge}</span>}
  <!-- Map -->
  <div class="w-full aspect-[16/9] bg-cream-100 rounded overflow-hidden">
    {mapEmbed
      ? <iframe
          src={mapEmbed}
          class="w-full h-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Mapa de ${name}`}
        ></iframe>
      : <div class="w-full h-full flex items-center justify-center text-charcoal-400 text-sm">
          <span>Mapa de {name}</span>
        </div>
    }
  </div>

  <div class="flex flex-col gap-4">
    <h3 class="font-display text-2xl text-charcoal-900">{name}</h3>

    <div class="flex flex-col gap-3 text-charcoal-700">
      <!-- Address -->
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-terracotta mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z" />
        </svg>
        <span class="text-sm">{address}</span>
      </div>

      <!-- Phone -->
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-terracotta flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
        </svg>
        <a href={`tel:${phone.replace(/\s/g, '')}`} class="text-sm hover:text-amber-dark transition-colors">{phone}</a>
      </div>

      <!-- Hours -->
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-terracotta mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <span class="text-sm whitespace-pre-line">{hours}</span>
      </div>
    </div>

    <a
      href={reserveHref}
      class="inline-flex items-center justify-center gap-2 mt-2 px-8 py-3.5 bg-amber text-charcoal-900 font-sans font-semibold text-sm tracking-widest uppercase rounded transition-all duration-300 hover:bg-amber-dark hover:-translate-y-0.5 hover:shadow-lg w-full"
    >
      Reservar en {name}
    </a>
  </div>
</div>
